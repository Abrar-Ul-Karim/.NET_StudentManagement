@model StudentModel


<div class="row">
    <div class="col-3"></div>

    <div class="col-6">
        <h1>Registration</h1>

        <form method="post">

            <div class="mb-3">
                <label class="from-label" asp-for="FullName"></label>
                <input type="text" class="form-control"  asp-for="FullName"/>
            </div>

            <div class="mb-3">
                @Html.LabelFor(m=>m.Age, new {@class="form-label"})
                @Html.TextBoxFor(m=>m.Age, new {@class="form-control"})

            </div>

            <button type="submit" class="btn btn-light">Submit</button>

        </form>

    </div>

    <div class="col-3"></div>
</div>


